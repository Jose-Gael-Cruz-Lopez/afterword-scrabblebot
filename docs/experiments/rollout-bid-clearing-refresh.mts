const dictionary = loadDictionary(), engine = new WordEngine(dictionary);
if(!readFileSync(new URL('../../bot-starter/src/simulate.ts',import.meta.url),'utf8').includes('publicWords'))throw new Error('Await public-word simulation plumbing before benchmark');
interface Candidate { name: string; options: ClearingBidOptions }
const candidates: Candidate[] = [
 {name:'refresh16-full',options:{maximumRounds:16,strength:1,samples:4,timeBudgetMs:70,riskPenalty:.5,improvementMargin:.5,thresholdSamples:16}},
 {name:'refresh16-half',options:{maximumRounds:16,strength:.5,samples:4,timeBudgetMs:70,riskPenalty:.5,improvementMargin:.5,thresholdSamples:16}},
];
function policy(name:string,options?:ClearingBidOptions,overrides:Partial<Params>={}):SimStrategy {
 const reference=new GauchoReference(dictionary,{name,terminalSafe:true,overrides});
 const tail=new LastTileDenial(new ExactTerminalStrategy(reference,{timeBudgetMs:18,maxNodes:8000}));
 const p=options?new ClearingPriceRolloutBidStrategy(tail,reference,options,(r,c,o)=>createMarketRolloutValuation(r,c,{...o,refreshAfterPurchases:3,sampleThreshold:(future,letter,rng)=>sampleRivalThreshold({...future,letter},rng,{clampToPublicBalances:false})})):tail;
 return {name,word:c=>p.word(c),bid:c=>p.bid(c)};
}
function pressure(price:number):SimStrategy{return{name:`pressure-${price}`,
 word(c){const w=engine.playable(c.myRack);return(c.roundsRemaining<=2||c.myBalance<price||c.roundsRemaining<=6?w[0]:w.find(x=>x.length>=7))?.word??null;},
 bid(c){if(c.roundsRemaining<=1)return 0;const before=engine.playable(c.myRack)[0]?.score??0,next=new Map(c.myRack);next.set(c.letter,(next.get(c.letter)??0)+1);return Math.min(c.myBalance,Math.max(price,Math.floor(((engine.playable(next)[0]?.score??0)-before)*1.1)));}};}
function patient():SimStrategy{return{name:'patient-seven',word(c){const w=engine.playable(c.myRack);return(c.roundsRemaining<=2||c.myBalance<12?w[0]:w.find(x=>x.length>=7))?.word??null;},bid:c=>c.roundsRemaining<=1?0:Math.min(c.myBalance,14)};}
const rosters=[
 {name:'production-clones-and-mutants',factories:[()=>policy('clone-A'),()=>policy('clone-B'),()=>policy('aggressive',undefined,{c0:.7,lowCash:18}),()=>policy('liquid',undefined,{lowCash:20,minPlayReward:32}),patient]},
 {name:'production-and-pressure',factories:[()=>policy('clone-A'),()=>policy('aggressive',undefined,{c0:.7,lowCash:18}),()=>pressure(14),()=>pressure(16),()=>pressure(18)]},
 {name:'production-and-patient',factories:[()=>policy('clone-A'),()=>policy('patient',undefined,{minPlayReward:50,pBase:.92}),()=>policy('liquid',undefined,{lowCash:20,minPlayReward:32}),patient,()=>pressure(16)]},
];
interface Scenario{seed:number;mode:SimAuctionType;players:number;seat:number;roster:number}
function scenarios(repetitions:number,start:number):Scenario[]{const out:Scenario[]=[];for(const mode of ['SecondPrice']as const)for(const players of[6,7])for(let n=0;n<players*repetitions;n++)out.push({seed:start+n*7919+players*100003+(mode==='FirstPrice'?10000003:0),mode,players,seat:n%players,roster:n%3});return out;}
let games=0;const errors:string[]=[];
function play(s:Scenario,candidate?:Candidate){const roster=rosters[s.roster]!,opponents=roster.factories.map(f=>f());if(s.players===7)opponents.push(policy('extra-production-clone'));opponents.splice(s.seat,0,policy(candidate?.name??'current-production',candidate?.options));const result=runMatch(opponents,s.seed,{dictionary,auctionType:s.mode});games++;errors.push(...result.errors);const p=result.players[s.seat]!,top=Math.max(...result.players.map(p=>p.score));return{score:p.score,win:p.score===top?1/result.players.filter(x=>x.score===top).length:0,rank:1+result.players.filter(x=>x.score>p.score).length,balance:p.balance,spent:p.spent,tiles:p.tilesWon,maxDecisionMs:Math.max(p.maxBidMs,p.maxWordMs),meanDecisionMs:(p.bidMs+p.wordMs)/(p.bidCalls+p.wordCalls)};}
type Outcome=ReturnType<typeof play>;
function stats(xs:Outcome[]){const n=xs.length,mean=(key:keyof Outcome)=>xs.reduce((a,x)=>a+x[key],0)/n;return{games:n,wins:xs.reduce((a,x)=>a+x.win,0),winRate:mean('win'),meanScore:mean('score'),meanRank:mean('rank'),meanBalance:mean('balance'),meanSpent:mean('spent'),meanTiles:mean('tiles'),maxDecisionMs:Math.max(...xs.map(x=>x.maxDecisionMs)),meanDecisionMs:mean('meanDecisionMs')};}
function pair(a:Outcome[],b:Outcome[]){const d=b.map((x,i)=>({score:x.score-a[i]!.score,win:x.win-a[i]!.win})),mean=(k:'win'|'score')=>d.reduce((n,x)=>n+x[k],0)/d.length,se=(k:'win'|'score')=>{const m=mean(k);return Math.sqrt(d.reduce((n,x)=>n+(x[k]-m)**2,0)/Math.max(1,d.length-1)/d.length);};return{scoreDelta:mean('score'),winDelta:mean('win'),scoreSE:se('score'),winSE:se('win'),betterScores:d.filter(x=>x.score>0).length,worseScores:d.filter(x=>x.score<0).length};}
const report:any={name:'rollout-bid-clearing-refresh',startedAt:new Date().toISOString(),methodology:'Last16 clearing-price integrated funded purchase valuation with refreshed localdictionary every3purchases andcashout, Vickrey. Current rival-threshold prior16equal-massquantiles; BUY-at-actualcost versusLOSE paired futurepayouts integratedonlywhenbid>threshold. Candidatebidboundaries threshold+1,0,normal,cash. Compare expectedutilityvsnormal includingnonmonotonecashouttriggers. Current exact+denial word/tail control. ForceLOSE versus BUY-at-cost share public-estimated futures, credits from actual simulated cashouts, and depleted future purchasing capital. Require full path to final payout. Two prespecified variants on26 paired training scenarios, balanced6/7seats; selected before52 untouched paired holdoutscenarios. No actual future/rival thresholds supplied.',candidates,rosters:rosters.map(r=>r.name),sourceHashes:Object.fromEntries(['./rollout-bid-clearing-refresh.mts','../../bot-starter/src/reference-gaucho/threshold-prior.ts','../../bot-starter/src/reference-gaucho/rollout-bid-clearing.ts','../../bot-starter/src/simulate.ts','../../bot-starter/src/strategy.ts','../../bot-starter/src/reference-gaucho/rollout-bid-rank.ts','../../bot-starter/src/reference-gaucho/rollout-bid.ts','../../bot-starter/src/reference-gaucho/rollout-cashout.ts','../../bot-starter/src/reference-gaucho/adapter.ts','../../bot-starter/src/reference-gaucho/terminal-exact.ts','../../bot-starter/src/last-tile-denial.ts'].map(f=>[f,createHash('sha256').update(readFileSync(new URL(f,import.meta.url))).digest('hex')])),trainingScenarios:scenarios(2,3670000211),training:[],errors};
const output=new URL('./rollout-bid-clearing-refresh-report.json',import.meta.url),start=performance.now(),controls=report.trainingScenarios.map((s:Scenario)=>play(s));report.trainingControl=stats(controls);
for(const c of candidates){const outcomes=report.trainingScenarios.map((s:Scenario)=>play(s,c)),row={candidate:c,summary:stats(outcomes),paired:pair(controls,outcomes),outcomes};report.training.push(row);report.games=games;report.elapsedMs=performance.now()-start;writeFileSync(output,JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({stage:'training',candidate:c.name,...row.summary,...row.paired,games,elapsedMs:report.elapsedMs}));}
const eligible=report.training.filter((r:any)=>r.paired.winDelta>0&&r.paired.scoreDelta>0).sort((a:any,b:any)=>b.paired.winDelta-a.paired.winDelta||b.paired.scoreDelta-a.paired.scoreDelta);const selected=eligible[0]??[...report.training].sort((a:any,b:any)=>b.paired.winDelta-a.paired.winDelta||b.paired.scoreDelta-a.paired.scoreDelta)[0];report.selectedBeforeHoldout=selected.candidate;report.jointTrainingWinner=!!eligible.length;writeFileSync(output,JSON.stringify(report,null,2)+'\n');
const cases=scenarios(4,3930000223),a:Outcome[]=[],b:Outcome[]=[];for(const s of cases){a.push(play(s));b.push(play(s,selected.candidate));if(a.length%13===0)console.log(JSON.stringify({stage:'holdout',pairs:a.length,games,elapsedMs:performance.now()-start}));}
report.holdout={scenarios:cases,control:stats(a),candidate:stats(b),paired:pair(a,b),controlOutcomes:a,candidateOutcomes:b,groups:Object.fromEntries([6,7].flatMap(n=>['SecondPrice'].map(mode=>{const ids=cases.flatMap((s,i)=>s.players===n&&s.mode===mode?[i]:[]),x=ids.map(i=>a[i]!),y=ids.map(i=>b[i]!);return[`${n}-${mode}`,{control:stats(x),candidate:stats(y),paired:pair(x,y)}];})))};
report.games=games;report.elapsedMs=performance.now()-start;report.finishedAt=new Date().toISOString();report.recommendation=report.holdout.paired.winDelta>0&&report.holdout.paired.scoreDelta>0?'observed joint heldout improvement; assess uncertainty before adoption':'do not adopt: no joint heldout improvement';writeFileSync(output,JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({stage:'complete',selected:report.selectedBeforeHoldout,games,errors:errors.length,control:report.holdout.control,candidate:report.holdout.candidate,paired:report.holdout.paired,recommendation:report.recommendation,elapsedMs:report.elapsedMs}));
